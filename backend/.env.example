# LLM API Keys
LITELLM_API_KEY=your-litellm-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Application Settings
DEBUG=true
APP_NAME=Neural Agent System

# Redis (will be overridden by docker-compose)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (will be overridden by docker-compose)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/neural_agent

# RabbitMQ (will be overridden by docker-compose)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Milvus (will be overridden by docker-compose)
MILVUS_URL=http://localhost:19530

# Task Settings
MAX_ITERATION=5
DEFAULT_LEARNING_RATE=0.1

# Trust Settings
TRUST_INITIAL_VALUE=1.0
TRUST_MIN_VALUE=0.0
TRUST_MAX_VALUE=2.0